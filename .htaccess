Options -Indexes
AddType application/javascript .mjs

# =========================================================
# 1. SECURITY & SEO HEADERS
# =========================================================
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Protect against Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # SEO: Block search engines from indexing backend/logic directories
    SetEnvIf Request_URI "^/project-sedna/(admin|actions|includes|config)/" NOINDEX_DIR
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_DIR
</IfModule>

# =========================================================
# 2. BROWSER CACHING (CORE WEB VITALS)
# =========================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache Images & Icons for 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Cache CSS and JS for 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# =========================================================
# 3. URL ROUTING & REWRITES
# =========================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Base URL for this folder
    RewriteBase /project-sedna/

    # ---------------------------------------------------------
    # THE ZERO-CONFLICT SHIELD
    # ---------------------------------------------------------
    # If the request matches a real file (-f) OR a real directory (-d),
    # stop right here and serve it directly. Do not rewrite.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Explicitly protect specific core folders from ever being routed to /pages/
    RewriteCond %{REQUEST_URI} ^/project-sedna/(admin|assets|includes|config|media)/ [NC]
    RewriteRule ^ - [L]
    # ---------------------------------------------------------

    # --- Sitemap Route ---
    # Route sitemap.xml to our dynamic sitemap.php file
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # --- PHP Handler (Pages) ---
    RewriteCond %{REQUEST_URI} ^/project-sedna/([a-zA-Z0-9_-]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/project-sedna/pages/%1.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ pages/$1.php [L]

    # --- HTML Handler (Pages) ---
    RewriteCond %{REQUEST_URI} ^/project-sedna/([a-zA-Z0-9_-]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/project-sedna/pages/%1.html -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ pages/$1.html [L]
</IfModule>